<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.memoryassistant.mapper.MarketFeedbackMapper">

    <!-- MarketFeedback 结果映射 -->
    <resultMap id="BaseResultMap" type="com.example.memoryassistant.entity.MarketFeedback">
        <id property="id" column="id"/>
        <result property="marketDeckId" column="market_deck_id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="contactInfo" column="contact_info"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!-- 插入反馈 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_market_feedback (market_deck_id, user_id, content, contact_info, status)
        VALUES (#{marketDeckId}, #{userId}, #{content}, #{contactInfo}, #{status})
    </insert>

</mapper>
